{
  "name": "@auntie-marlenes/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "require": "./dist/types.js",
      "types": "./dist/types.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && node scripts/copy-prisma-assets.mjs",
    "dev": "tsc --watch",
    "clean": "rm -rf .turbo node_modules",
    "typecheck": "pnpm check-types",
    "db:generate": "prisma generate && prisma generate --schema scripts/pg-schema.prisma",
    "db:studio": "prisma studio",
    "check-types": "tsc --noEmit --emitDeclarationOnly false && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply auntie-marlenes-dev --local --persist-to .wrangler/state -c ../../apps/web/wrangler.dev.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply auntie-marlenes --remote",
    "db:check-drift": "node scripts/check-drift.mjs",
    "db:copy-from-neon": "pnpm db:generate && tsx scripts/copy-from-neon.ts",
    "db:parity": "pnpm db:generate && tsx scripts/parity.ts",
    "db:migrate:dev": "wrangler d1 migrations apply auntie-marlenes-dev --remote -c ../../apps/web/wrangler.dev.jsonc",
    "db:dev:pull": "node scripts/dev-pull.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.1",
    "@prisma/adapter-d1": "7.8.0",
    "@prisma/client": "7.8.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@prisma/adapter-better-sqlite3": "7.8.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/internals": "7.8.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "better-sqlite3": "^12.11.1",
    "prisma": "7.8.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.151.2"
  }
}
