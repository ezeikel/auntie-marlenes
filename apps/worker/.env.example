# --- HTTP server (Hetzner box) ---
# Port the Hono server binds. The shared box runbook allocates 3020 to Auntie
# Marlene's content worker. See deploy/README.md.
PORT=3020

# Shared secret gating /publish/*, /schedule, and /generate/blog. The web app /
# Vercel cron send it as `Authorization: Bearer <WORKER_SECRET>` (on the web
# side it is CONTENT_WORKER_SECRET and MUST match this value). Unset = open
# (local dev only).
WORKER_SECRET=

# --- Anthropic (Opus 4.8 judges blog featured images) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- OpenAI (blog text: gpt-4o / gpt-4o-mini; gpt-image-2 image fallback) ---
# https://platform.openai.com/api-keys — required for blog generation. Without
# it the blog text/meta fail; the image step also needs it for the gpt-image-2
# fallback (else the post publishes without an image when no Pexels match clears
# the bar).
OPENAI_API_KEY=

# --- Google (product scene image generation — existing social pipeline) ---
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Pexels (blog featured-image stock search, first choice) ---
# https://www.pexels.com/api/ — the blog tries Pexels photos (judged by Opus
# 4.8) before falling back to gpt-image-2. Optional: unset = always generate.
PEXELS_API_KEY=

# --- Sanity (blog CMS write path) ---
# Same project/dataset as the web app. On the box these point at production.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-01-01
# Write token (Editor role) — required for the worker to create + publish posts
# and upload featured-image assets.
SANITY_WRITE_TOKEN=

# --- Cloudflare R2 (hosts product post/reel media for the social pipeline) ---
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- Meta Graph API (existing social auto-posting) ---
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# --- Shopify (existing product/catalog pipeline) ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
