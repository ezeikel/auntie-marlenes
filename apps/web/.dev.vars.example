# Copy to .dev.vars (gitignored). Runtime-only values belong here.
# Copy the read-only Shopify/Sanity public settings from .env.local.
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_STOREFRONT_API_ENDPOINT="https://your-store.myshopify.com/api/2026-01/graphql.json"
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_WEBHOOK_SECRET=""
NEXT_PUBLIC_SANITY_PROJECT_ID="zm0a7rrv"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-01-01"
NEXT_AUTH_SECRET="local-test-only-replace-me"
AUTH_TRUST_HOST="true"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_WEB_CLIENT_ID=""
APPLE_MOBILE_CLIENT_ID="com.chewybytes.auntiemarlenes.app"
RESEND_API_KEY="re_local_test_invalid"
CRON_SECRET="local-test-only-replace-me"
SANITY_REVALIDATE_SECRET="local-test-only-replace-me"
# Local QA uses a no-op HTTP worker. Production requires a public hostname.
CONTENT_WORKER_URL="http://localhost:3029"
CONTENT_WORKER_SECRET="local-test-only-replace-me"
# Unset locally. Use production/staging explicitly on the hosted environments.
APP_ENV=""
NEXT_PUBLIC_APP_ENV=""
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
