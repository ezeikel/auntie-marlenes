# ===========================================
# Auntie Marlene's Web Environment Variables
# ===========================================

# Database
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Authentication
NEXT_AUTH_SECRET="generate-with-openssl-rand-base64-32"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# API
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# ===========================================
# Shopify
# ===========================================
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN="your-storefront-access-token"
SHOPIFY_STOREFRONT_API_ENDPOINT="https://your-store.myshopify.com/api/2023-07/graphql.json"
SHOPIFY_ADMIN_API_ENDPOINT="https://your-store.myshopify.com/admin/api/2023-07/graphql.json"
SHOPIFY_WEBHOOK_SECRET="your-webhook-secret"

# ===========================================
# Sanity CMS
# ===========================================
# Required - Get from sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID="zm0a7rrv"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2025-02-19"

# Required for write operations (blog generation)
# Create at: sanity.io/manage -> Project -> API -> Tokens
# Needs Editor or higher permissions
SANITY_API_TOKEN="your-sanity-api-token"

# Webhook secret for cache revalidation
# Create at: sanity.io/manage -> Project -> API -> Webhooks
# Generate with: openssl rand -base64 32
SANITY_REVALIDATE_SECRET="your-sanity-webhook-secret"

# ===========================================
# AI Services (for Blog Generation)
# ===========================================
# Anthropic - Used for blog content generation (text = claude-sonnet-5)
# Get from: console.anthropic.com/settings/keys (shared fleet key)
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key"

# OpenAI - legacy / optional (text generation moved to Anthropic)
# Get from: platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key"

# Google AI - Used for image evaluation and fallback image generation
# Get from: aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY="your-google-ai-api-key"

# ===========================================
# Pexels (for Blog Images)
# ===========================================
# Get from: www.pexels.com/api/
PEXELS_API_KEY="your-pexels-api-key"

# ===========================================
# Cron Job Security
# ===========================================
# Secret for authenticating cron job requests
# Generate with: openssl rand -base64 32
CRON_SECRET="your-cron-secret"

# ===========================================
# Analytics & Monitoring
# ===========================================
# PostHog
NEXT_PUBLIC_POSTHOG_KEY="your-posthog-key"
NEXT_PUBLIC_POSTHOG_HOST="/relay-hyx5"

# Sentry
NEXT_PUBLIC_SENTRY_DSN="your-sentry-dsn"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="your-sentry-project"

# Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID="your-meta-pixel-id"

# ===========================================
# Email (Resend)
# ===========================================
RESEND_API_KEY="re_your-resend-api-key"

# ===========================================
# FontAwesome Pro
# ===========================================
FONTAWESOME_NPM_AUTH_TOKEN="your-fontawesome-token"

# ===========================================
# Vercel (auto-injected in Vercel deployments)
# ===========================================
# VERCEL_OIDC_TOKEN (auto-injected)
