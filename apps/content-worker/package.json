    "@remotion/renderer": "^4.0.0",
    "@runwayml/sdk": "^3.18.0",
    "ai": "^6.0.27",
    "dotenv": "^17.2.2",
    "hono": "^4.0.0",
    "remotion": "^4.0.0",
    "satori": "^0.26.0",
