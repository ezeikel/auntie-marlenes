    "nativewind": "5.0.0-preview.2",
    "posthog-react-native": "^4.10.8",
    "posthog-react-native-session-replay": "^1.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.81.5",
