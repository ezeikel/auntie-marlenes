# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_API_URL_ANDROID=http://10.0.2.2:3000

# Shopify
EXPO_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_shopify_storefront_access_token_here

# Authentication - Google
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id_here

# Authentication - Facebook
EXPO_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id_here
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=your_facebook_client_token_here

# Analytics - PostHog
EXPO_PUBLIC_POSTHOG_API_KEY=your_posthog_api_key_here

# Monitoring - Sentry
EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
